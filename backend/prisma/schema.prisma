generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENSEIGNANT
  ETUDIANT
}

enum Sexe {
  M
  F
}

enum StatutActif {
  ACTIF
  INACTIF
}

enum StatutEnseignant {
  ACTIF
  EN_CONGE
}

enum StatutCours {
  PLANIFIE
  REALISE
  ANNULE
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
  ABSENCE_JUSTIFIEE
}

enum StatutJustificatif {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

enum NotificationType {
  ABSENCE
  RETARD
  PLANNING_MODIFIE
  JUSTIFICATIF
  NOUVEAU_COMPTE
  CHANGEMENT_STATUT
  INFO_ADMIN
}

model Utilisateur {
  id          Int      @id @default(autoincrement())
  nom         String
  prenom      String
  email       String?  @unique
  telephone   String?  @unique
  motDePasse  String   @map("mot_de_passe")
  role        Role
  fonction    String?
  departement String?
  photoUrl    String?  @map("photo_url")
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  etudiant              Etudiant?
  enseignant            Enseignant?
  presencesEnregistrees Presence[]            @relation("EnregistrePar")
  justificatifsTraites  Justificatif[]        @relation("TraitePar")
  notifications         Notification[]
  resetTokens           PasswordResetToken[]
  verificationCodes     VerificationCode[]

  @@map("utilisateurs")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model VerificationCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("verification_codes")
}

model Filiere {
  id          Int    @id @default(autoincrement())
  nomFiliere  String @map("nom_filiere")
  departement String?

  classes Classe[]

  @@map("filieres")
}

model Classe {
  id                    Int     @id @default(autoincrement())
  nomClasse             String  @map("nom_classe")
  niveau                String
  filiereId             Int     @map("filiere_id")
  effectifMax           Int?    @map("effectif_max")
  enseignantResponsableId Int?  @map("enseignant_responsable_id")

  filiere               Filiere     @relation(fields: [filiereId], references: [id])
  enseignantResponsable Enseignant? @relation("Responsable", fields: [enseignantResponsableId], references: [id])
  etudiants             Etudiant[]
  affectations          Affectation[]

  @@map("classes")
}

model Etudiant {
  id            Int          @id @default(autoincrement())
  utilisateurId Int?         @unique @map("utilisateur_id")
  matricule     String       @unique
  nom           String
  prenom        String
  dateNaissance DateTime?    @map("date_naissance")
  sexe          Sexe?
  email         String?
  telephone     String?
  classeId      Int          @map("classe_id")
  statut        StatutActif  @default(ACTIF)
  createdAt     DateTime     @default(now()) @map("created_at")

  utilisateur   Utilisateur?  @relation(fields: [utilisateurId], references: [id])
  classe        Classe        @relation(fields: [classeId], references: [id])
  presences     Presence[]
  justificatifs Justificatif[]

  @@map("etudiants")
}

model Enseignant {
  id             Int              @id @default(autoincrement())
  utilisateurId  Int?             @unique @map("utilisateur_id")
  matriculeEns   String           @unique @map("matricule_ens")
  nom            String
  prenom         String
  email          String?
  telephone      String?
  specialite     String?
  statut         StatutEnseignant @default(ACTIF)
  createdAt      DateTime         @default(now()) @map("created_at")

  utilisateur      Utilisateur?  @relation(fields: [utilisateurId], references: [id])
  classesResponsable Classe[]    @relation("Responsable")
  affectations     Affectation[]

  @@map("enseignants")
}

model Matiere {
  id          Int    @id @default(autoincrement())
  code        String @unique
  nomMatiere  String @map("nom_matiere")
  coefficient Int    @default(1)

  affectations Affectation[]

  @@map("matieres")
}

model Affectation {
  id           Int @id @default(autoincrement())
  matiereId    Int @map("matiere_id")
  enseignantId Int @map("enseignant_id")
  classeId     Int @map("classe_id")

  matiere    Matiere    @relation(fields: [matiereId], references: [id])
  enseignant Enseignant @relation(fields: [enseignantId], references: [id])
  classe     Classe     @relation(fields: [classeId], references: [id])
  cours      Cours[]

  @@unique([matiereId, classeId])
  @@map("affectations")
}

model Cours {
  id            Int         @id @default(autoincrement())
  affectationId Int         @map("affectation_id")
  date          DateTime    @db.Date
  heureDebut    String      @map("heure_debut")
  heureFin      String?     @map("heure_fin")
  salle         String?
  statut        StatutCours @default(PLANIFIE)
  createdAt     DateTime    @default(now()) @map("created_at")

  affectation Affectation @relation(fields: [affectationId], references: [id])
  presences   Presence[]

  @@index([date])
  @@map("cours")
}

model Presence {
  id                 Int            @id @default(autoincrement())
  etudiantId         Int            @map("etudiant_id")
  coursId            Int            @map("cours_id")
  statut             StatutPresence
  heureEnregistrement DateTime      @default(now()) @map("heure_enregistrement")
  enregistreParId    Int?           @map("enregistre_par_id")

  etudiant      Etudiant      @relation(fields: [etudiantId], references: [id])
  cours         Cours         @relation(fields: [coursId], references: [id])
  enregistrePar Utilisateur?  @relation("EnregistrePar", fields: [enregistreParId], references: [id])
  justificatif  Justificatif?

  @@unique([etudiantId, coursId])
  @@map("presences")
}

model Justificatif {
  id             Int                @id @default(autoincrement())
  etudiantId     Int                @map("etudiant_id")
  presenceId     Int                @unique @map("presence_id")
  motif          String             @db.Text
  documentUrl    String?            @map("document_url")
  statut         StatutJustificatif @default(EN_ATTENTE)
  traiteParId    Int?               @map("traite_par_id")
  dateSoumission DateTime           @default(now()) @map("date_soumission")
  dateTraitement DateTime?          @map("date_traitement")

  etudiant  Etudiant     @relation(fields: [etudiantId], references: [id])
  presence  Presence     @relation(fields: [presenceId], references: [id])
  traitePar Utilisateur? @relation("TraitePar", fields: [traiteParId], references: [id])

  @@map("justificatifs")
}
